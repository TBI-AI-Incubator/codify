# Copied to .env, which the CLI reads (nothing overrides a variable already exported).

# Chat model for body-fill, transcription and metadata: any OpenAI-compatible
# endpoint (a provider's API directly, or a gateway). Gemini's is shown; the
# live_llm tests need a gateway.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.7-flash
# Optional: retried on any content-filter refusal (Gemini's RECITATION on published
# law), for page reads, metadata and body-fill alike, at that model's cost. Unset,
# a refused page is recorded as unreadable.
# LLM_CONTENT_FILTER_FALLBACK_MODEL=

# Database tests and migrations. Matches docker-compose.yaml.
POSTGRES_URL=postgresql://codify:codify@localhost:5432/codify

# Fetching from official sources: the User-Agent every request carries, naming
# you and a contact. Unset, an acquirer stops before its first request.
ACQUISITION_USER_AGENT=

# Optional: a second OCR engine for scanned pages (Azure AI Foundry, Mistral OCR).
# Unset, every page is read once by the chat model's vision route.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=

# Optional: Langfuse tracing.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
